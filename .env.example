# --- Core ---------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Pooled connection used at runtime. Supplied automatically by the Supabase
# integration as POSTGRES_PRISMA_URL; set explicitly only for local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/framecast
# Unpooled connection used by migrations. Supplied as POSTGRES_URL_NON_POOLING.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/framecast
# Supabase signs Postgres with its own CA, which is not in Node's trust store.
# Download: Supabase Dashboard -> Settings -> Database -> SSL Configuration.
# In a .env file, paste the PEM as a single double-quoted value with \n between
# lines. In Vercel's env var UI, paste the raw multi-line PEM as-is — Vercel
# stores the literal bytes, no escaping needed.
SUPABASE_CA_CERT=
# Local escape hatch only: encrypts but does not authenticate the database
# connection. config/env.ts refuses it when NODE_ENV=production.
DATABASE_SSL_INSECURE=false
# No TLS at all — only for a Postgres that speaks none, e.g. docker-compose's
# own `postgres` service. config/env.ts refuses this unless DATABASE_URL's host
# is a single-label name — no dots, and not an IPv4/IPv6 address literal. That
# check is lexical only (it never resolves the name), so only ever set this for
# a host you know is actually private.
DATABASE_SSL_DISABLE=false

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Secrets encryption -------------------------------------------------
# 32 bytes, base64. Encrypts provider API keys at rest.
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# --- YouTube OAuth (channel connection) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Storage (local disk) -------------------------------------------------
# Objects (clips, narration, captions, thumbnails, logos) and finished
# renders. Absolute paths in a deployed environment; the defaults below are
# git-ignored and need no configuration for `pnpm dev` or the test suite.
STORAGE_ROOT=.framecast/storage
RENDER_ROOT=.framecast/renders

# --- AI -------------------------------------------------------------------
# Vercel AI Gateway. Optional: a stored ANTHROPIC credential takes precedence.
AI_GATEWAY_API_KEY=
AI_SCRIPT_MODEL=anthropic/claude-sonnet-5
# Image model for thumbnails and logos, through the same gateway as
# AI_SCRIPT_MODEL.
AI_IMAGE_MODEL=openai/gpt-image-1

# --- ElevenLabs (narration) ----------------------------------------------
# Full voice list: GET https://api.elevenlabs.io/v1/voices (needs an API key,
# stored per-operator via the Providers page, not here).
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# --- Stock footage (Pexels + Pixabay) -------------------------------------
# Platform-level, not per-operator — set here rather than on the Providers
# page. App still boots without them; footage collection throws a clear
# ProviderError if a key it needs is missing.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# --- Background music (Jamendo) -------------------------------------------
# Platform-level, like the stock footage keys above. Pixabay has no music API,
# so this is a separate account: https://devportal.jamendo.com. Leaving it
# empty is safe — videos simply render without a music bed.
JAMENDO_CLIENT_ID=

# --- Seed (development only) --------------------------------------------
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=

# --- SEO ------------------------------------------------------------------
# Google Search Console's HTML-tag ownership token, which OAuth branding
# verification requires before it accepts framecasts.com as this app's
# homepage. Leave empty and no meta tag is emitted at all.
#
# Read at BUILD time, not run time: the public pages are statically
# prerendered, so setting this on an already-built container changes nothing.
# Set it before `next build` / `docker build` and redeploy.
GOOGLE_SITE_VERIFICATION=
