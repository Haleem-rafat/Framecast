# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Design preview only: stubs auth and serves fixture data so the UI renders with
# no database. Rejected at startup when NODE_ENV=production.
PREVIEW_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/framecast

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Secrets encryption -------------------------------------------------
# 32 bytes, base64. Encrypts provider API keys at rest.
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# --- YouTube OAuth (channel connection) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase Storage ---------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=framecast

# --- Seed (development only) --------------------------------------------
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
