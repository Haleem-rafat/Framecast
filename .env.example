# --- Core ---------------------------------------------------------------
NODE_ENV=development
# Design preview only: stubs auth and serves fixture data so the UI renders with
# no database. Rejected at startup when NODE_ENV=production.
PREVIEW_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database -----------------------------------------------------------
# Pooled connection used at runtime. Supplied automatically by the Supabase
# integration as POSTGRES_PRISMA_URL; set explicitly only for local Postgres.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/framecast
# Unpooled connection used by migrations. Supplied as POSTGRES_URL_NON_POOLING.
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/framecast

# --- Auth ---------------------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Secrets encryption -------------------------------------------------
# 32 bytes, base64. Encrypts provider API keys at rest.
# openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# --- YouTube OAuth (channel connection) ---------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Supabase Storage ---------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=framecast
# Supabase signs Postgres with its own CA, which is not in Node's trust store.
# Download: Supabase Dashboard -> Settings -> Database -> SSL Configuration.
# Paste the PEM as a single double-quoted value with \n between lines.
SUPABASE_CA_CERT=
# Local escape hatch only: encrypts but does not authenticate the database
# connection. config/env.ts refuses it when NODE_ENV=production.
DATABASE_SSL_INSECURE=false

# --- Seed (development only) --------------------------------------------
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
SEED_USER_NAME=
