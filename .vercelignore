# CLI deploys upload the working directory, which would otherwise include local
# .env files. Those carry real secrets and — worse — silently shadow the values
# configured in the Vercel project, so a deploy would run on whatever happened to
# be on this laptop. Git-triggered deploys never see these; CLI deploys must not either.
.env
.env.*
!.env.example

# Finished renders: 178MB of MP4s that must never reach a deploy.
.framecast

node_modules
.next
.git
.superpowers
coverage
*.tsbuildinfo
