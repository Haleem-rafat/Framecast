# deploy/prod.env.example
#
# Template for /srv/framecast/env/prod.env — loaded by app-prod and
# worker-prod via `env_file:` in deploy/docker-compose.yml. Copy this file to
# the server, fill in every placeholder, then delete or ignore this comment
# block. The real file lives ONLY at /srv/framecast/env/prod.env on the VPS
# and is never committed — see docs/vps-deployment.md, Step 5.
#
# This file (the .example one) intentionally contains no secrets: every
# value below is either a fixed setting or a placeholder in <angle brackets>
# naming where the real value comes from.

NODE_ENV=production

# <POSTGRES_USER> / <POSTGRES_PASSWORD> must be the same values set in
# /srv/framecast/.env, which Compose interpolates into the postgres service.
# `postgres` is the Compose service name, reachable only on the internal
# Compose network — never expose 5432 to the host or the internet.
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/framecast
DIRECT_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/framecast

# Permitted here and ONLY here: src/config/env.ts refuses DATABASE_SSL_DISABLE
# unless DATABASE_URL's host is a single-label name (no dots, not an IP
# literal) — `postgres` on the Compose network is exactly that, and traffic
# never leaves the host's own network namespace. Do not copy this setting to
# any environment where the database host is a real domain or IP.
DATABASE_SSL_DISABLE=true

BETTER_AUTH_URL=https://framecasts.com
NEXT_PUBLIC_APP_URL=https://framecasts.com

# Container-side paths from deploy/docker-compose.yml's volumes, not a
# default either app picks on its own. Get these wrong (or leave them unset)
# and writes land in the container's own throwaway filesystem instead of the
# bind mount: nothing errors, and the data is simply gone on next recreate.
STORAGE_ROOT=/data/storage
RENDER_ROOT=/data/renders

# openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand--base64-32>

# MUST be copied byte-for-byte from the current production deployment.
# Generating a new value here makes every already-stored provider API key
# undecryptable, with no recovery. See docs/vps-deployment.md, Step 5, for
# where to read the existing value from and how to verify it round-trips.
CREDENTIAL_ENCRYPTION_KEY=<copy-unchanged-from-current-deployment>

GOOGLE_CLIENT_ID=<from-Google-Cloud-Console-OAuth-client>
GOOGLE_CLIENT_SECRET=<from-Google-Cloud-Console-OAuth-client>

AI_GATEWAY_API_KEY=<from-Vercel-AI-Gateway>

PEXELS_API_KEY=<from-Pexels-API-dashboard>
PIXABAY_API_KEY=<from-Pixabay-API-dashboard>
JAMENDO_CLIENT_ID=<from-Jamendo-developer-portal>

# Seeded operator address; also the first entry on the sign-in allowlist.
SEED_USER_EMAIL=<operator-email>

# AI_SCRIPT_MODEL, AI_IMAGE_MODEL, ELEVENLABS_VOICE_ID, ELEVENLABS_MODEL_ID,
# and AUTH_ALLOWED_EMAILS are not listed above because src/config/env.ts
# gives each a working default or treats it as optional. Set them here only
# to override a default.
