# deploy/staging.env.example
#
# Template for /srv/framecast/env/staging.env — loaded by app-staging and
# worker-staging via `env_file:` in deploy/docker-compose.yml. Same rules as
# deploy/prod.env.example (copy to the server, fill in every placeholder,
# never commit the real file) — see docs/vps-deployment.md, Step 5.
#
# Differs from prod.env in exactly three places: the database name, the
# hostname, and JAMENDO_CLIENT_ID left empty so staging test renders don't
# spend the shared music quota. Everything else — including
# CREDENTIAL_ENCRYPTION_KEY — is the same value as prod.env, because it's a
# platform-level credential, not one scoped per environment.

NODE_ENV=production

# Same Postgres instance as prod, different database — see deploy/README.md
# ("One Postgres instance holding two databases"). <POSTGRES_USER> /
# <POSTGRES_PASSWORD> are the same values as in prod.env and in
# /srv/framecast/.env.
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/framecast_staging
DIRECT_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@postgres:5432/framecast_staging

# See the long comment in deploy/prod.env.example — same justification
# applies verbatim to `postgres` on this network.
DATABASE_SSL_DISABLE=true

BETTER_AUTH_URL=https://staging.framecasts.com
NEXT_PUBLIC_APP_URL=https://staging.framecasts.com

STORAGE_ROOT=/data/storage
RENDER_ROOT=/data/renders

# Generate a SEPARATE secret from prod's — unlike CREDENTIAL_ENCRYPTION_KEY,
# this one is fine to differ per environment (it only signs staging's own
# sessions).
# openssl rand -base64 32
BETTER_AUTH_SECRET=<generate-with-openssl-rand--base64-32>

# Copied byte-for-byte from prod.env — not regenerated. See the warning in
# deploy/prod.env.example: a different key here just means staging can't
# decrypt any provider key that was ever copied over from production data.
CREDENTIAL_ENCRYPTION_KEY=<same-value-as-prod.env>

GOOGLE_CLIENT_ID=<from-Google-Cloud-Console-OAuth-client>
GOOGLE_CLIENT_SECRET=<from-Google-Cloud-Console-OAuth-client>

AI_GATEWAY_API_KEY=<from-Vercel-AI-Gateway>

PEXELS_API_KEY=<from-Pexels-API-dashboard>
PIXABAY_API_KEY=<from-Pixabay-API-dashboard>

# Left empty on purpose: test renders on staging must not consume the shared
# Jamendo quota. Videos simply render without a music bed — see
# src/config/env.ts's comment on JAMENDO_CLIENT_ID.
JAMENDO_CLIENT_ID=

SEED_USER_EMAIL=<operator-email>
