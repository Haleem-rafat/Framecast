# deploy/compose.env.example
#
# Template for /srv/framecast/.env — the file **Compose itself** reads to
# interpolate `${...}` in deploy/docker-compose.yml before any container
# starts. This is a third, separate file from prod.env and staging.env
# (Step 5 of docs/vps-deployment.md) and from backup.env: those are handed to
# containers via `env_file:`, this one is never seen by a container at all.
#
# It must sit next to docker-compose.yml on the server, i.e.
# /srv/framecast/.env, and `docker compose` must be run from that directory
# (or with --project-directory pointing at it) for it to be picked up.
#
#   scp deploy/compose.env.example root@51.38.80.36:/srv/framecast/.env
#   # then edit it in place on the server and:
#   chmod 600 /srv/framecast/.env
#
# It holds POSTGRES_PASSWORD, so it is a secret file like the others: never
# committed, never copied back into a checkout.

# The GHCR namespace the images were published under. MUST be lowercase —
# GHCR rejects uppercase in image paths, and this repository's owner is
# `Haleem-rafat`. `GITHUB_OWNER=Haleem-rafat` makes every
# ghcr.io/${GITHUB_OWNER}/... reference invalid. See deploy/README.md.
GITHUB_OWNER=haleem-rafat

# Creates the Postgres superuser on first boot AND is what prod.env's and
# staging.env's DATABASE_URL/DIRECT_URL must authenticate as — the three files
# have to agree. deploy/backup.sh's own backup.env needs the same user again.
#
# docker-compose.yml declares these with `:?`, so an unset value stops
# `docker compose up` immediately with the variable's name. Without that, the
# postgres healthcheck silently degrades to `pg_isready -U ` and every
# `depends_on: service_healthy` waits forever with nothing pointing at why.
POSTGRES_USER=<postgres-user>
POSTGRES_PASSWORD=<postgres-password>

# Optional. Which published image tag to run; docker-compose.yml defaults to
# `latest` when this is unset. Pin it to a specific tag to roll back:
#   IMAGE_TAG=sha-abc1234
IMAGE_TAG=latest
