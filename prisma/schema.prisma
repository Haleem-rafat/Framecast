// ---------------------------------------------------------------------------
// Scenes & assets
// ---------------------------------------------------------------------------

enum SceneStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Scene {
  id           String      @id @default(uuid()) @db.Uuid
  index        Int
  prompt       String
  narration    String?
  status       SceneStatus @default(PENDING)
  startSeconds Float?
  endSeconds   Float?

  /// Which of the six narrative beats this scene belongs to — HOOK, TENSION,
  /// MECHANISM, NAME_IT, TURN, LOOP.
  ///
  /// Null for every scene produced by any other format, which is every scene
  /// that exists today. A `String?` rather than an enum precisely because it is
  /// one format's vocabulary: a second format with different beats should be a
  /// different set of strings, not a migration that teaches the database about
  /// somebody else's story structure.
  ///
  /// The renderer reads this for exactly one thing — which join dips through
  /// black, being the one before NAME_IT. Everything else a beat means is the
  /// writer's concern and never reaches FFmpeg.
  beat String?

  /// Words the narration should stress, as the script chose them.
  ///
  /// A `String[]` rather than markup inside `narration`, so the narration stays
  /// the plain text that both the aligner and the captions read. Marking up the
  /// spoken text would mean every consumer had to know how to strip it, and the
  /// one that forgot would either speak the markup aloud or burn it on screen.
  ///
  /// Applied by the TTS layer and coloured by the kinetic captions
  /// (`kinetic-captions.ts`). Empty for every scene that does not stress
  /// anything, which is every scene that exists today.
  emphasis String[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  assets Asset[]

  @@unique([videoId, index])
  @@map("scene")
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  MUSIC
  SUBTITLE
}

model Asset {
  id          String          @id @default(uuid()) @db.Uuid
  kind        AssetKind
  storagePath String
  url         String?
  mimeType    String?
  sizeBytes   BigInt?
  provider    AiProviderType?
  model       String?
  prompt      String?
  /// The source provider's id for this asset (e.g. a Pexels/Pixabay video
  /// id). Lets a stage skip re-downloading something it already fetched.
  externalId  String?
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?

  sceneId String? @db.Uuid
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  // No direct videoId column: every object (and therefore every Asset that
  // references one) lives under `videos/{videoId}/...` in storage, and
  // render.service.ts (Task 6) already established `storagePath` prefix
  // matching as the one convention for scoping an Asset to its video —
  // see its videoId-scoped queries. A second, parallel videoId column here
  // would let some writers populate it and others not, and a query that
  // filtered on it would then silently miss real rows.
  @@index([sceneId, kind])
  @@map("asset")
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model RenderJob {
  id         String       @id @default(uuid()) @db.Uuid
  status     RenderStatus @default(QUEUED)
  progress   Int          @default(0)
  outputUrl  String?
  error      String?
  attempts   Int          @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  logs RenderLog[]

  @@index([videoId, createdAt])
  @@index([status])
  @@map("render_job")
}

model RenderLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel @default(INFO)
  message   String
  createdAt DateTime @default(now())

  renderJobId String    @db.Uuid
  renderJob   RenderJob @relation(fields: [renderJobId], references: [id], onDelete: Cascade)

  @@index([renderJobId, createdAt])
  @@map("render_log")
}

// ---------------------------------------------------------------------------
// Shorts
// ---------------------------------------------------------------------------

/// Mirrors the useful half of `VideoStatus` rather than `RenderStatus`, because
/// a Short has a lifecycle of its own — it is claimed, leased and released by
/// the same worker loop a Video is (see shorts.service.ts's claimNext/heartbeat/
/// release), not merely a record of one FFmpeg invocation the way a RenderJob is.
///
/// Shorts CAN now be published, which reverses what this comment used to say.
/// The publish dialog offers "also publish these shorts" as an explicit,
/// off-by-default choice, and `publish.service.ts` uploads the READY ones in the
/// same click that uploads the video. What has not changed is that nothing
/// reaches YouTube without the operator ticking that box: `/automation` and the
/// schedules still stop at a READY video, and the button is still the only
/// caller.
///
/// There is still no PUBLISHED member, but the reason is now different. This
/// enum tracks the *encode* — queued, being cut, cut, or unable to be cut —
/// and a short that has been uploaded is still a cut short with a playable file
/// underneath it; folding "on YouTube" into the same column would make READY
/// mean "has a file" in three places and "has a file and has not been uploaded"
/// in a fourth. The upload is recorded on `ShortPublication` instead, one row
/// per short, whose `@unique` `shortId` is also what makes publishing a short
/// one-shot — exactly the way `Publication.videoId` does it for the video.
///
/// No CANCELLED member either, and that reason is unchanged: a short is at most
/// a minute of already-rendered footage re-encoded from one local file, which
/// takes seconds; cooperative cancellation exists for the ten-minute full
/// render, and adding a `cancelRequestedAt` here would be a second cancellation
/// protocol guarding something that finishes before an operator could press the
/// button.
enum ShortStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

/// One vertical clip cut out of a finished video.
///
/// The time window is stored in *source-video seconds*, not as a character
/// range into the script, even though ShortsService picks the moment by
/// choosing script sections. Seconds are what survives: the rendered MP4 this
/// window indexes into is immutable once written, whereas `ScriptVersion.content`
/// can be edited afterwards, which would silently re-point a stored character
/// offset at different words while the picture it describes never moved. The
/// caption slice needed at render time is recovered from these same seconds
/// against the narration alignment (see `sliceAlignment` in shorts-plan.ts), so
/// nothing downstream needs the character offsets either.
///
/// No `deletedAt`, unlike Channel/Project/Video/Asset. Every other child of
/// Video — Scene, RenderJob, Publication, VideoStatusEvent — likewise has none,
/// and soft deletion would actively hurt here: `@@unique([videoId, index])` is
/// what stops a double-clicked "Generate" writing two overlapping sets, and a
/// soft-deleted row still occupies its slot, so regeneration would be blocked by
/// rows that every query already filters out. Regeneration therefore hard-deletes
/// the previous set (and its files) and writes a fresh one.
model Short {
  id    String @id @default(uuid()) @db.Uuid
  /// Position in the generated set, 0-based. Also the play order the panel
  /// lists them in, so a regenerated set is stable rather than ordered by
  /// whichever insert happened to land first.
  index Int

  /// The window into the *source video's* timeline, in seconds. Both come from
  /// the narration alignment, which is the same timeline the finished render
  /// uses — see shorts-plan.ts's `planShortWindow` for why those two are the
  /// same timeline and not merely similar ones.
  startSeconds Float
  endSeconds   Float

  /// Written by the same model that chose the window, in the same structured
  /// response. Kept nullable because a short is renderable and reviewable
  /// without them, and because they were written for an operator's manual
  /// upload before this app could publish a short at all. Publishing now uses
  /// them when they are there and falls back to the parent video's own title
  /// and description when they are not — see `buildShortMetadata` in
  /// publish.service.ts.
  title       String?
  description String?
  /// One sentence on why this moment was picked, shown in the panel. The
  /// operator's only way to judge a selection without watching all three.
  reason      String?

  status     ShortStatus @default(QUEUED)
  /// Path relative to RENDER_ROOT, e.g. `shorts/<id>.mp4` — the same "a path,
  /// never a URL" arrangement as `RenderJob.outputUrl` (see render-storage.ts).
  /// Named `outputPath` rather than repeating that column's misleading name.
  outputPath String?
  error      String?

  /// Same lease model as Video's, for the same reason: a worker that dies
  /// mid-encode must not strand this row forever. A lock would; a lease that
  /// lapses lets the next worker retake it. See shorts.service.ts.
  leaseExpiresAt DateTime?
  /// Bounded by the same MAX_ATTEMPTS a Video is, so a short that fails
  /// deterministically stops re-encoding on every poll.
  attempts       Int       @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// At most one, and it is the record of this short's single upload — see
  /// ShortPublication. Cascades away with the row, which matters because
  /// regenerating a set hard-deletes it: a published short whose set is
  /// regenerated loses its local record while the clip stays up on YouTube.
  /// Regeneration after publishing is already a dead end for other reasons
  /// (the render it would re-cut from was reclaimed at publish time, so every
  /// new short fails), so this is not a new trap, but it is the one thing this
  /// cascade gives up.
  publication ShortPublication?

  /// Every slot that released this clip — in practice zero rows or one, since
  /// a published short leaves the release queue for good. Kept as a list
  /// because the FK is `SetNull` and history outlives the row it points at.
  releaseRuns ReleaseRun[]

  /// Doubles as the panel's list index: "every short for one video, in play
  /// order" is a prefix scan of this same b-tree, so no second `@@index`
  /// on `[videoId, index]` is added for it.
  @@unique([videoId, index])
  /// `claimNext`'s candidate scan — queued-and-unleased, or leased by a worker
  /// that died. Mirrors Video's own `@@index([status, leaseExpiresAt])`.
  @@index([status, leaseExpiresAt])
  @@map("short")
}

// ---------------------------------------------------------------------------
// Publishing
// ---------------------------------------------------------------------------

enum PublishVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PublishStatus {
  PENDING
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
}

model Publication {
  id               String            @id @default(uuid()) @db.Uuid
  youtubeVideoId   String?
  title            String
  description      String?
  tags             String[]
  playlistId       String?
  visibility       PublishVisibility @default(PRIVATE)
  status           PublishStatus     @default(PENDING)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  error            String?
  /// False when the video published but its thumbnail did not attach — most
  /// often because the YouTube channel is not verified, which custom
  /// thumbnails require. Not a publish failure; a thing the operator can fix
  /// and retry.
  ///
  /// False on its own is not a report, which is what `thumbnailError` beside
  /// it is for: this column alone cannot tell "there was no thumbnail to
  /// attach" apart from "YouTube refused it", and the first video this app
  /// ever published went up with a YouTube-chosen frame and nothing anywhere
  /// saying why.
  thumbnailApplied Boolean           @default(false)
  /// Why the thumbnail did not attach, in a sentence safe to show the
  /// operator verbatim. Null when it attached, and null when the video had no
  /// thumbnail to attach in the first place — a `false`/`null` pair means
  /// "nothing to do", a `false` with a message means "YouTube said no".
  ///
  /// Cleared on a successful retry (`publishService.retryThumbnail`), which is
  /// deliberately *not* covered by the one-shot publish guard: `thumbnails.set`
  /// is a separate endpoint from `videos.insert`, costs 50 units, and attaching
  /// the same image twice is idempotent — none of the reasons publishing is
  /// one-shot apply to it.
  thumbnailError   String?
  /// How many of `totalBytes` YouTube has confirmed it holds, written once per
  /// upload chunk by `publish()` — see `uploadToYouTube`'s chunked branch.
  ///
  /// Confirmed, not merely written to a socket: an intermediate chunk answers
  /// `308` with a `Range` header naming the last byte YouTube actually stored,
  /// and that is the number recorded here. Anything looser would be an
  /// optimistic guess presented as a measurement, which is the exact failure
  /// this column exists to end — a publish that reports nothing and a publish
  /// that has died look identical from a spinner.
  ///
  /// `Int`, not `BigInt`, caps this at ~2GB. A Framecast render is ~170MB and
  /// the largest one this app has produced is 463MB, and a `BigInt` here would
  /// travel to a client component through a Server Action, where it is not
  /// serialisable. If renders ever approach 2GB, this column and `totalBytes`
  /// move together.
  uploadedBytes    Int               @default(0)
  /// The size of the file this attempt is uploading, recorded the moment the
  /// render is opened and before the first byte goes out. Null for an attempt
  /// that failed before it got that far (a missing render, an unusable OAuth
  /// grant), which is the honest reading: nothing was ever going to be sent.
  totalBytes       Int?
  /// When bytes actually started moving, which is *not* `createdAt` — the claim
  /// row is taken first, and resolving a token and opening the render sit
  /// between them. The observed rate, and therefore every estimate shown to the
  /// operator, is measured from here.
  uploadStartedAt  DateTime?
  /// The lease, and the only thing that tells a slow upload apart from a dead
  /// one. Exactly the mechanism `Video.leaseExpiresAt` uses for renders (see
  /// `JobService.claimNext`), for exactly the same failure: the process holding
  /// this row can be killed — a deploy restarting the app container mid-upload
  /// is how this was found — and a killed process runs no `catch`, so the row
  /// it left behind says `UPLOADING` forever and `videoId @unique` then blocks
  /// every retry.
  ///
  /// Renewed every `HEARTBEAT_SECONDS` for as long as `publish()` is running,
  /// on a timer rather than on upload progress. That distinction is the whole
  /// safety argument: a 463MB file over a slow uplink legitimately sends
  /// nothing for minutes at a time, so "no bytes recently" is not evidence of
  /// death, whereas "no heartbeat for ten minutes" means the process is gone.
  ///
  /// Nothing reclaims a lapsed lease automatically. Unlike a render, an
  /// interrupted upload may already have left a video on the channel, so a
  /// lapsed lease only makes the row *clearable by the operator* — see
  /// `PublishService.clearStuckPublication`.
  leaseExpiresAt   DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  analytics VideoAnalytic[]

  @@index([channelId, status])
  @@index([scheduledFor])
  @@map("publication")
}

/// One short's upload to YouTube. Publication's smaller twin, and deliberately
/// a separate table rather than a nullable set of columns on Short.
///
/// The reason is the `@unique` on `shortId`. Publishing a short is one-shot for
/// the same reason publishing a video is — the upload cannot be undone from
/// this app, and a retry that silently uploaded a second copy would be worse
/// than no retry at all — and the way `publish.service.ts` enforces that for a
/// video is to `create()` the claim row *before* a single byte is sent, letting
/// Postgres' unique index settle any race. A status column on Short would need
/// a conditional update to do the same job less directly, and would collide
/// with the encode lifecycle `ShortStatus` already tracks (see its comment).
///
/// A FAILED row is kept, never deleted, exactly as Publication's is: it is the
/// record that an attempt happened, and it is what stops a second click firing
/// another upload at a short that may already be on YouTube. There is no retry
/// path here either — clearing the row is a manual step.
///
/// No `scheduledFor` of its own. A short is published in the same click as its
/// parent video and inherits that publish's schedule and visibility outright
/// (there is no second picker), so a column here could only ever disagree with
/// the Publication row next to it.
model ShortPublication {
  id             String            @id @default(uuid()) @db.Uuid
  youtubeVideoId String?
  /// What was actually sent, not what the Short row says now — the same
  /// "record what YouTube was told" rule Publication.title follows, and the
  /// only place the clamped, credit-bearing text that went up is kept.
  title          String
  description    String?
  /// Always the parent publish's visibility. Stored rather than derived so a
  /// clip that went out public is still recorded as public after someone
  /// changes anything else.
  visibility     PublishVisibility @default(PRIVATE)
  status         PublishStatus     @default(UPLOADING)
  error          String?
  publishedAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  shortId String @unique @db.Uuid
  short   Short  @relation(fields: [shortId], references: [id], onDelete: Cascade)

  /// The channel the clip was uploaded to. Reachable through
  /// `short.video.project.channel`, but denormalised for the same reason
  /// Publication denormalises it: a project can be reassigned to another
  /// channel afterwards, and the row must keep saying where the upload
  /// actually went.
  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, status])
  @@map("short_publication")
}

/// Daily analytics snapshot per publication.
model VideoAnalytic {
  id                 String   @id @default(uuid()) @db.Uuid
  views              BigInt   @default(0)
  likes              BigInt   @default(0)
  comments           BigInt   @default(0)
  impressions        BigInt   @default(0)
  clickThroughRate   Float    @default(0)
  averageViewSeconds Float    @default(0)
  watchTimeMinutes   Float    @default(0)
  subscribersGained  Int      @default(0)
  estimatedRevenue   Decimal  @default(0) @db.Decimal(12, 4)
  capturedFor        DateTime @db.Date
  createdAt          DateTime @default(now())

  publicationId String      @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, capturedFor])
  @@index([capturedFor])
  @@map("video_analytic")
}

// ---------------------------------------------------------------------------
// Prompt library
// ---------------------------------------------------------------------------

enum PromptCategory {
  SCRIPT
  THUMBNAIL
  SCENE
  TITLE
  DESCRIPTION
  TAGS
