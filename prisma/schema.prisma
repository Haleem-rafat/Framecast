// Framecast — data model.
//
// Conventions enforced across every model:
//   - UUID primary keys
//   - createdAt / updatedAt timestamps
//   - `deletedAt` soft delete on user-owned domain entities
//   - every entity is scoped to a User so multi-tenancy is a filter change, not a migration

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth managed tables)
// ---------------------------------------------------------------------------

/// Whether a self-registered account may actually use the studio.
///
/// framecasts.com is a public URL and every render spends real money — Pexels
/// footage, ElevenLabs narration, an Anthropic script — against the operator's
/// own API keys. Open registration would let any stranger who finds the domain
/// spend those credits, so a new account can sign in and see that it is waiting
/// but can do nothing else until an existing operator approves it.
enum AccountApproval {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  /// Defaults to PENDING so a newly registered account is gated by default —
  /// a bug that skips the approval write must fail closed, not open. Every
  /// account that existed before approval did is backfilled to APPROVED by
  /// the migration that adds this column; without that backfill the column's
  /// default would lock every existing operator out of their own studio.
  approval      AccountApproval @default(PENDING)
  approvedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sessions            Session[]
  accounts            Account[]
  channels            Channel[]
  projects            Project[]
  videos              Video[]
  promptTemplates     PromptTemplate[]
  providerCredentials ProviderCredential[]
  activityLogs        ActivityLog[]
  settings            UserSetting?
  schedules           Schedule[]

  /// The approvals queue reads "every account still PENDING, oldest first".
  @@index([approval, createdAt])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Channels
// ---------------------------------------------------------------------------

model Channel {
  id                               String    @id @default(uuid()) @db.Uuid
  youtubeChannelId                 String
  title                            String
  handle                           String?
  description                      String?
  thumbnailUrl                     String?
  // OAuth tokens are written by the server only and never selected into client payloads.
  accessToken                      String
  refreshToken                     String
  tokenExpiresAt                   DateTime
  scopes                           String[]
  isActive                         Boolean   @default(true)
  /// ElevenLabs pronunciation dictionary for this channel. Entries accumulate
  /// as scripts introduce new proper nouns, so a correction made once never
  /// recurs on this channel. Null until the first script needs one.
  pronunciationDictionaryId        String?
  pronunciationDictionaryVersionId String?
  connectedAt                      DateTime  @default(now())
  createdAt                        DateTime  @default(now())
  updatedAt                        DateTime  @updatedAt
  deletedAt                        DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  statistics   ChannelStatistic[]
  publications Publication[]
  projects     Project[]
  brand        ChannelBrand?

  @@unique([userId, youtubeChannelId])
  @@index([userId, deletedAt])
  @@map("channel")
}

/// Point-in-time snapshot so channel growth is derivable without mutating Channel.
model ChannelStatistic {
  id              String   @id @default(uuid()) @db.Uuid
  subscriberCount BigInt   @default(0)
  viewCount       BigInt   @default(0)
  videoCount      Int      @default(0)
  capturedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([channelId, capturedAt])
  @@map("channel_statistic")
}

/// A channel's identity: what its videos look like, sound like and are about.
///
/// Deliberately a separate table rather than columns on `Channel`. `Channel`
/// holds OAuth access and refresh tokens — the one row here whose accidental
/// exposure is a security incident, and whose own comment says those tokens are
/// never selected into client payloads. Brand fields are the opposite: read
/// constantly, rendered in the UI, edited by the operator. Separating them means
/// the brand editor never has to select from the row holding the tokens.
model ChannelBrand {
  id String @id @default(uuid()) @db.Uuid

  /// The VideoStyle object, merged over DEFAULT_STYLE. Null means "all
  /// defaults", so an existing channel renders exactly as it does today and
  /// this column needs no backfill.
  videoStyle Json?

  logoPath        String?
  primaryColour   String?
  secondaryColour String?
  /// Must exist in the worker image — libass and drawtext both fall back
  /// silently on a missing face.
  headlineFont    String?
  tone            String?
  niche           String?
  /// What to search Jamendo for. A channel's music should sound consistent,
  /// and a video's title is not a musical description — which is why searching
  /// by title found nothing usable.
  musicQuery      String?

  /// BCP-47, e.g. `en`. Sent to YouTube on every upload from this channel as
  /// *both* `snippet.defaultLanguage` (what the title and description are
  /// written in) and `snippet.defaultAudioLanguage` (what the narration is
  /// spoken in). One column rather than two because those two can never
  /// disagree here: the description is built from the same script the voice
  /// reads, so a channel whose metadata is English and whose audio is not is
  /// not a state this pipeline can produce.
  ///
  /// Non-null with a default, unlike the branding columns above, because
  /// YouTube's own behaviour for an *absent* language is the thing being
  /// fixed — it guesses, and a wrong guess costs the video its place in
  /// recommendations for the audience that speaks it.
  language   String @default("en")
  /// YouTube's video category, as the numeric string the Data API wants
  /// (`"27"`, not `27` and not `"Education"`). The assignable set is
  /// region-dependent, so the picker lists what `videoCategories.list`
  /// returns for the channel's own country rather than anything hardcoded —
  /// see `BrandService.listCategories`.
  ///
  /// 27 (Education) is the default: this app makes narrated explainers with a
  /// SOURCES block in the description, and Education is assignable in every
  /// region YouTube publishes categories for. A channel that is really about
  /// hardware or software changes it to 28 in the channel's publishing
  /// defaults.
  categoryId String @default("27")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  channelId String  @unique @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("channel_brand")
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  archivedAt  DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional default publishing target for videos in this project.
  channelId String?  @db.Uuid
  channel   Channel? @relation(fields: [channelId], references: [id], onDelete: SetNull)

  videos    Video[]
  schedules Schedule[]

  @@index([userId, status, deletedAt])
  @@map("project")
}

// ---------------------------------------------------------------------------
// Videos — the pipeline aggregate root
// ---------------------------------------------------------------------------

enum VideoStatus {
  DRAFT
  QUEUED
  GENERATING
  RENDERING
  READY
  PUBLISHED
  FAILED
}

model Video {
  id                   String      @id @default(uuid()) @db.Uuid
  title                String
  description          String?
  /// Written by MetadataService, kept separate from the operator's own `title`
  /// and `description` so a model can never silently overwrite what a human
  /// typed. `publish()` sends `generatedTitle ?? title`.
  generatedTitle       String?
  generatedDescription String?
  tags                 String[]
  topic                String?
  status               VideoStatus @default(DRAFT)
  // Denormalised only as a UI hint; the durable record lives in VideoStatusEvent.
  failureReason        String?
  durationSeconds      Int?
  /// Worker lease. Null when unclaimed; a value in the past means the holder
  /// died and the video is claimable again. A lock would strand it forever.
  leaseExpiresAt       DateTime?
  /// Guards a deterministically-failing video against retrying until the end of
  /// time, spending real provider money each round.
  attempts             Int         @default(0)
  /// Cooperative cancellation. The worker owns the FFmpeg child process, so
  /// only it can stop one; it checks this on every heartbeat.
  cancelRequestedAt    DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  deletedAt            DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  script       Script?
  voiceOver    VoiceOver?
  thumbnail    Thumbnail?
  scenes       Scene[]
  renderJobs   RenderJob[]
  publication  Publication?
  statusEvents VideoStatusEvent[]
  shorts       Short[]
  scheduleRuns ScheduleRun[]

  @@index([userId, status, deletedAt])
  @@index([projectId, deletedAt])
  @@index([createdAt])
  @@index([status, leaseExpiresAt])
  @@map("video")
}

/// Append-only pipeline history. Never updated — one row per transition.
model VideoStatusEvent {
  id        String       @id @default(uuid()) @db.Uuid
  from      VideoStatus?
  to        VideoStatus
  message   String?
  createdAt DateTime     @default(now())

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@index([videoId, createdAt])
  @@map("video_status_event")
}

// ---------------------------------------------------------------------------
// Script
// ---------------------------------------------------------------------------

model Script {
  id              String   @id @default(uuid()) @db.Uuid
  activeVersionId String?  @unique @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  versions      ScriptVersion[] @relation("ScriptVersions")
  activeVersion ScriptVersion?  @relation("ActiveScriptVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@map("script")
}

model ScriptVersion {
  id        String          @id @default(uuid()) @db.Uuid
  version   Int
  content   String
  wordCount Int             @default(0)
  /// Ordered b-roll cues, one per narration section, as ScriptCue[] (see
  /// src/lib/script-cues.ts). Nullable with no backfill: scripts written
  /// before this feature render exactly as they did, drawing entirely from
  /// the topic-level fallback pool.
  cues      Json?
  /// The citations the model was asked to gather, as a string[] — one source
  /// per entry. Stored here rather than inside `content` because `content` is
  /// narration and nothing else: it is sent verbatim to ElevenLabs, so a URL
  /// left in it is a URL read aloud. publish.service.ts turns this into the
  /// SOURCES block of the video description. Nullable with no backfill, same
  /// as `cues`: a script written before this column exists still has its
  /// sources inline, and `extractSourcesSection` still finds them there.
  sources   Json?
  // The rendered prompt actually sent, retained for reproducibility.
  prompt    String?
  model     String?
  provider  AiProviderType?
  createdAt DateTime        @default(now())

  scriptId String @db.Uuid
  script   Script @relation("ScriptVersions", fields: [scriptId], references: [id], onDelete: Cascade)

  activeFor Script? @relation("ActiveScriptVersion")

  @@unique([scriptId, version])
  @@index([scriptId, createdAt])
  @@map("script_version")
}

// ---------------------------------------------------------------------------
// Voice
// ---------------------------------------------------------------------------

model VoiceOver {
  id              String         @id @default(uuid()) @db.Uuid
  provider        AiProviderType
  voiceId         String
  voiceName       String?
  speed           Float          @default(1.0)
  emotion         String?
  audioUrl        String?
  durationSeconds Int?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@map("voice_over")
}

// ---------------------------------------------------------------------------
// Thumbnail
// ---------------------------------------------------------------------------

model Thumbnail {
  id              String   @id @default(uuid()) @db.Uuid
  activeVersionId String?  @unique @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  versions      ThumbnailVersion[] @relation("ThumbnailVersions")
  activeVersion ThumbnailVersion?  @relation("ActiveThumbnailVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  @@map("thumbnail")
}

model ThumbnailVersion {
  id        String          @id @default(uuid()) @db.Uuid
  version   Int
  imageUrl  String
  prompt    String
  provider  AiProviderType?
  model     String?
  createdAt DateTime        @default(now())

  thumbnailId String    @db.Uuid
  thumbnail   Thumbnail @relation("ThumbnailVersions", fields: [thumbnailId], references: [id], onDelete: Cascade)

  activeFor Thumbnail? @relation("ActiveThumbnailVersion")

  @@unique([thumbnailId, version])
  @@map("thumbnail_version")
}

// ---------------------------------------------------------------------------
// Scenes & assets
// ---------------------------------------------------------------------------

enum SceneStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model Scene {
  id           String      @id @default(uuid()) @db.Uuid
  index        Int
  prompt       String
  narration    String?
  status       SceneStatus @default(PENDING)
  startSeconds Float?
  endSeconds   Float?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  assets Asset[]

  @@unique([videoId, index])
  @@map("scene")
}

enum AssetKind {
  IMAGE
  VIDEO
  AUDIO
  MUSIC
  SUBTITLE
}

model Asset {
  id          String          @id @default(uuid()) @db.Uuid
  kind        AssetKind
  storagePath String
  url         String?
  mimeType    String?
  sizeBytes   BigInt?
  provider    AiProviderType?
  model       String?
  prompt      String?
  /// The source provider's id for this asset (e.g. a Pexels/Pixabay video
  /// id). Lets a stage skip re-downloading something it already fetched.
  externalId  String?
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?

  sceneId String? @db.Uuid
  scene   Scene?  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  // No direct videoId column: every object (and therefore every Asset that
  // references one) lives under `videos/{videoId}/...` in storage, and
  // render.service.ts (Task 6) already established `storagePath` prefix
  // matching as the one convention for scoping an Asset to its video —
  // see its videoId-scoped queries. A second, parallel videoId column here
  // would let some writers populate it and others not, and a query that
  // filtered on it would then silently miss real rows.
  @@index([sceneId, kind])
  @@map("asset")
}

// ---------------------------------------------------------------------------
// Rendering
// ---------------------------------------------------------------------------

enum RenderStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

model RenderJob {
  id         String       @id @default(uuid()) @db.Uuid
  status     RenderStatus @default(QUEUED)
  progress   Int          @default(0)
  outputUrl  String?
  error      String?
  attempts   Int          @default(0)
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  logs RenderLog[]

  @@index([videoId, createdAt])
  @@index([status])
  @@map("render_job")
}

model RenderLog {
  id        String   @id @default(uuid()) @db.Uuid
  level     LogLevel @default(INFO)
  message   String
  createdAt DateTime @default(now())

  renderJobId String    @db.Uuid
  renderJob   RenderJob @relation(fields: [renderJobId], references: [id], onDelete: Cascade)

  @@index([renderJobId, createdAt])
  @@map("render_log")
}

// ---------------------------------------------------------------------------
// Shorts
// ---------------------------------------------------------------------------

/// Mirrors the useful half of `VideoStatus` rather than `RenderStatus`, because
/// a Short has a lifecycle of its own — it is claimed, leased and released by
/// the same worker loop a Video is (see shorts.service.ts's claimNext/heartbeat/
/// release), not merely a record of one FFmpeg invocation the way a RenderJob is.
///
/// There is no PUBLISHED member and no CANCELLED member, both deliberately.
/// Shorts are never auto-published — generation produces drafts an operator
/// reviews — so nothing in this codebase may move a Short past READY. And a
/// short is at most a minute of already-rendered footage re-encoded from one
/// local file, which takes seconds; cooperative cancellation exists for the
/// ten-minute full render, and adding a `cancelRequestedAt` here would be a
/// second cancellation protocol guarding something that finishes before an
/// operator could press the button.
enum ShortStatus {
  QUEUED
  RENDERING
  READY
  FAILED
}

/// One vertical clip cut out of a finished video.
///
/// The time window is stored in *source-video seconds*, not as a character
/// range into the script, even though ShortsService picks the moment by
/// choosing script sections. Seconds are what survives: the rendered MP4 this
/// window indexes into is immutable once written, whereas `ScriptVersion.content`
/// can be edited afterwards, which would silently re-point a stored character
/// offset at different words while the picture it describes never moved. The
/// caption slice needed at render time is recovered from these same seconds
/// against the narration alignment (see `sliceAlignment` in shorts-plan.ts), so
/// nothing downstream needs the character offsets either.
///
/// No `deletedAt`, unlike Channel/Project/Video/Asset. Every other child of
/// Video — Scene, RenderJob, Publication, VideoStatusEvent — likewise has none,
/// and soft deletion would actively hurt here: `@@unique([videoId, index])` is
/// what stops a double-clicked "Generate" writing two overlapping sets, and a
/// soft-deleted row still occupies its slot, so regeneration would be blocked by
/// rows that every query already filters out. Regeneration therefore hard-deletes
/// the previous set (and its files) and writes a fresh one.
model Short {
  id    String @id @default(uuid()) @db.Uuid
  /// Position in the generated set, 0-based. Also the play order the panel
  /// lists them in, so a regenerated set is stable rather than ordered by
  /// whichever insert happened to land first.
  index Int

  /// The window into the *source video's* timeline, in seconds. Both come from
  /// the narration alignment, which is the same timeline the finished render
  /// uses — see shorts-plan.ts's `planShortWindow` for why those two are the
  /// same timeline and not merely similar ones.
  startSeconds Float
  endSeconds   Float

  /// Written by the same model that chose the window, in the same structured
  /// response. Kept nullable because a short is renderable and reviewable
  /// without them — they are for the operator's eventual manual upload, and
  /// nothing in this codebase publishes a short.
  title       String?
  description String?
  /// One sentence on why this moment was picked, shown in the panel. The
  /// operator's only way to judge a selection without watching all three.
  reason      String?

  status     ShortStatus @default(QUEUED)
  /// Path relative to RENDER_ROOT, e.g. `shorts/<id>.mp4` — the same "a path,
  /// never a URL" arrangement as `RenderJob.outputUrl` (see render-storage.ts).
  /// Named `outputPath` rather than repeating that column's misleading name.
  outputPath String?
  error      String?

  /// Same lease model as Video's, for the same reason: a worker that dies
  /// mid-encode must not strand this row forever. A lock would; a lease that
  /// lapses lets the next worker retake it. See shorts.service.ts.
  leaseExpiresAt DateTime?
  /// Bounded by the same MAX_ATTEMPTS a Video is, so a short that fails
  /// deterministically stops re-encoding on every poll.
  attempts       Int       @default(0)

  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  videoId String @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  /// Doubles as the panel's list index: "every short for one video, in play
  /// order" is a prefix scan of this same b-tree, so no second `@@index`
  /// on `[videoId, index]` is added for it.
  @@unique([videoId, index])
  /// `claimNext`'s candidate scan — queued-and-unleased, or leased by a worker
  /// that died. Mirrors Video's own `@@index([status, leaseExpiresAt])`.
  @@index([status, leaseExpiresAt])
  @@map("short")
}

// ---------------------------------------------------------------------------
// Publishing
// ---------------------------------------------------------------------------

enum PublishVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PublishStatus {
  PENDING
  SCHEDULED
  UPLOADING
  PUBLISHED
  FAILED
}

model Publication {
  id               String            @id @default(uuid()) @db.Uuid
  youtubeVideoId   String?
  title            String
  description      String?
  tags             String[]
  playlistId       String?
  visibility       PublishVisibility @default(PRIVATE)
  status           PublishStatus     @default(PENDING)
  scheduledFor     DateTime?
  publishedAt      DateTime?
  error            String?
  /// False when the video published but its thumbnail did not attach — most
  /// often because the YouTube channel is not verified, which custom
  /// thumbnails require. Not a publish failure; a thing the operator can fix
  /// and retry.
  thumbnailApplied Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  analytics VideoAnalytic[]

  @@index([channelId, status])
  @@index([scheduledFor])
  @@map("publication")
}

/// Daily analytics snapshot per publication.
model VideoAnalytic {
  id                 String   @id @default(uuid()) @db.Uuid
  views              BigInt   @default(0)
  likes              BigInt   @default(0)
  comments           BigInt   @default(0)
  impressions        BigInt   @default(0)
  clickThroughRate   Float    @default(0)
  averageViewSeconds Float    @default(0)
  watchTimeMinutes   Float    @default(0)
  subscribersGained  Int      @default(0)
  estimatedRevenue   Decimal  @default(0) @db.Decimal(12, 4)
  capturedFor        DateTime @db.Date
  createdAt          DateTime @default(now())

  publicationId String      @db.Uuid
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  @@unique([publicationId, capturedFor])
  @@index([capturedFor])
  @@map("video_analytic")
}

// ---------------------------------------------------------------------------
// Prompt library
// ---------------------------------------------------------------------------

enum PromptCategory {
  SCRIPT
  THUMBNAIL
  SCENE
  TITLE
  DESCRIPTION
  TAGS
}

model PromptTemplate {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    PromptCategory
  content     String
  isDefault   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  variables PromptVariable[]

  @@unique([userId, name])
  @@index([userId, category, deletedAt])
  @@map("prompt_template")
}

model PromptVariable {
  id           String  @id @default(uuid()) @db.Uuid
  key          String
  label        String
  defaultValue String?
  required     Boolean @default(false)

  promptTemplateId String         @db.Uuid
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Cascade)

  @@unique([promptTemplateId, key])
  @@map("prompt_variable")
}

// ---------------------------------------------------------------------------
// AI providers
// ---------------------------------------------------------------------------

enum AiProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  ELEVENLABS
  GOOGLE_VEO
  RUNWAY
  KLING
  REPLICATE
  PIKA
  LUMA
  /// Stock footage. Platform-level keys (see env.ts), never a per-operator
  /// ProviderCredential row — used only to tag Asset.provider.
  PEXELS
  PIXABAY
  /// Background music, same platform-level arrangement as the two above.
  JAMENDO
}

model ProviderCredential {
  id           String         @id @default(uuid()) @db.Uuid
  provider     AiProviderType
  label        String?
  /// AES-256-GCM ciphertext. Never selected into any client-bound payload.
  encryptedKey String
  keyLastFour  String
  isActive     Boolean        @default(true)
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usages ProviderUsage[]

  @@unique([userId, provider])
  @@index([userId, deletedAt])
  @@map("provider_credential")
}

model ProviderUsage {
  id           String         @id @default(uuid()) @db.Uuid
  provider     AiProviderType
  operation    String
  model        String?
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  requestCount Int            @default(1)
  costUsd      Decimal        @default(0) @db.Decimal(12, 6)
  succeeded    Boolean        @default(true)
  latencyMs    Int?
  createdAt    DateTime       @default(now())

  credentialId String?             @db.Uuid
  credential   ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([credentialId, createdAt])
  @@map("provider_usage")
}

// ---------------------------------------------------------------------------
// Scheduled automation
// ---------------------------------------------------------------------------

/// How often a schedule fires.
///
/// Two members, and deliberately not a cron expression. This product has
/// exactly one flow — topic in, video out — and every run costs real provider
/// money, so the useful range is "a video a week" to "a video a month". A cron
/// field would additionally admit `* * * * *`, which is a way to spend an
/// operator's entire Anthropic balance in an afternoon by mistyping one
/// character, and would have to be validated back down to roughly this set
/// anyway. Nothing here forecloses adding DAILY later; the arithmetic in
/// src/lib/schedule-time.ts is written per-frequency precisely so a third
/// member is a new branch rather than a rewrite.
enum ScheduleFrequency {
  WEEKLY
  MONTHLY
}

/// PAUSED is the only state in which the due-check ignores a schedule, and it
/// is reached three ways: the operator presses Pause, the topic queue runs dry,
/// or the run has failed `MAX_CONSECUTIVE_FAILURES` times in a row. All three
/// write `pausedReason`, because a schedule that stopped on its own has to be
/// able to say why — an operator who finds no video on Monday needs the answer
/// on the schedule itself, not in a log they would have to know to look for.
enum ScheduleStatus {
  ACTIVE
  PAUSED
}

/// What happened at one occurrence.
///
/// SKIPPED and MISSED are different things and the distinction is the point.
/// SKIPPED means the occurrence came round, the worker looked, and there was a
/// reason not to spend money — no ElevenLabs key, no topics left, the project
/// archived. MISSED means nothing looked at all: the occurrence passed while
/// the worker was down, and `advancePast` recorded it on the way past rather
/// than running it late (see src/lib/schedule-time.ts for why a missed
/// occurrence is never made up).
enum ScheduleRunOutcome {
  SUCCEEDED
  SKIPPED
  FAILED
  MISSED
}

/// A recurring instruction to produce a video: which project, how often, and
/// with which answers to the operator's own prompt variables.
///
/// The timing columns store *local wall-clock fields plus an IANA zone*, never
/// a UTC time of day. "Every Monday at 09:00" has to keep meaning 09:00 in the
/// operator's zone across a DST transition, and a stored UTC hour cannot: it
/// would drift by an hour twice a year, silently, in the direction nobody
/// checks. `nextRunAt` is the only UTC instant here, it is derived from those
/// fields, and it is re-derived (never incremented) every time the schedule
/// fires — see `ScheduleService.claimDue`.
model Schedule {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  status       ScheduleStatus @default(ACTIVE)
  /// Written whenever `status` becomes PAUSED, cleared on resume. Null for an
  /// ACTIVE schedule and for one the operator paused by hand without comment.
  pausedReason String?

  frequency  ScheduleFrequency
  /// 0 = Sunday … 6 = Saturday. Set for WEEKLY, null for MONTHLY.
  dayOfWeek  Int?
  /// 1–31. Set for MONTHLY, null for WEEKLY. A day the month does not have
  /// clamps to that month's last day rather than skipping the month.
  dayOfMonth Int?
  hour       Int
  minute     Int
  /// IANA zone name, e.g. `Europe/London`. Validated on the way in — a typo
  /// here would otherwise throw inside the worker's poll loop weeks later.
  timeZone   String

  /// Answers for the variables the operator's default SCRIPT prompt declares,
  /// keyed by `PromptVariable.key` — the same map the guided flow submits. Json
  /// rather than a child table for the same reason `AutomationService` takes a
  /// plain record: which keys exist is a property of a template the operator
  /// can edit at any moment, so a schema that enumerated them would need a
  /// migration every time somebody renamed a variable.
  variables Json @default("{}")

  /// The next instant this schedule is due, derived from the fields above. Null
  /// only while paused with no future occurrence computed. This column is the
  /// lock: a claim advances it in the same conditional update that wins it, so
  /// two concurrent ticks can never both fire the same occurrence.
  nextRunAt DateTime?
  /// When the last claim was taken — not when a video was produced. A run that
  /// skipped still moved this, because it is what proves the tick loop looked.
  lastRunAt DateTime?

  /// Held for the duration of one run, so a second worker does not start the
  /// same occurrence while the first is still inside `automationService.start`.
  /// A lease rather than a lock, exactly like `Video.leaseExpiresAt`: a worker
  /// that dies mid-run must not strand the schedule forever.
  claimExpiresAt DateTime?

  /// Reset to zero by any successful run. A schedule that fails this many times
  /// in a row pauses itself rather than billing an Anthropic call every week
  /// for a fault nobody is watching.
  consecutiveFailures Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cascade, not SetNull: a schedule with no project has nowhere to put a
  /// video and no honest state to sit in. Deleting the project is the operator
  /// saying they are done with this line of work.
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  topics ScheduleTopic[]
  runs   ScheduleRun[]

  /// The due-check's candidate scan: active schedules whose next occurrence has
  /// arrived, oldest first. Mirrors `Video`'s own `[status, leaseExpiresAt]`.
  @@index([status, nextRunAt])
  @@index([userId, deletedAt])
  @@map("schedule")
}

/// One subject the operator wrote ahead of time, waiting its turn.
///
/// The queue is where topics come from, rather than a model inventing one each
/// week. A standing instruction ("pick something about personal finance") would
/// mean the studio choosing the subject of a video the operator pays for and
/// puts their name on, and getting that wrong is not a small failure — it is a
/// video about something they would never have covered, discovered after it was
/// rendered. A queue is cheap, predictable, reviewable in advance, and when it
/// empties the schedule stops rather than improvising.
model ScheduleTopic {
  id         String    @id @default(uuid()) @db.Uuid
  /// Sort key, not an index into anything. Consumed rows keep their position so
  /// history reads in the order the operator wrote them.
  position   Int
  topic      String
  /// Set when a run takes this topic, which happens *before* the model is
  /// called — see `ScheduleService.executeClaim` for why a failed run does not
  /// put the topic back.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  scheduleId String   @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// "The next unconsumed topic for this schedule" is a prefix scan of this
  /// b-tree, which is the single hottest query in the tick path.
  @@index([scheduleId, consumedAt, position])
  @@map("schedule_topic")
}

/// Append-only history: one row per occurrence, whatever became of it.
///
/// Every occurrence writes a row, including the ones that produced nothing.
/// "No video appeared on Monday" is the question this table exists to answer,
/// and it can only answer it if a skip is as visible as a success.
model ScheduleRun {
  id           String             @id @default(uuid()) @db.Uuid
  /// The occurrence this row is about, not when the row was written. Those
  /// differ for a run the worker picked up late, and the occurrence is the one
  /// the operator can reason about.
  scheduledFor DateTime
  outcome      ScheduleRunOutcome
  /// Why, in the operator's terms. Always set for SKIPPED, FAILED and MISSED;
  /// null for a plain success.
  reason       String?
  /// The topic this run consumed, copied rather than referenced: the
  /// `ScheduleTopic` row can be removed by the operator, and history that
  /// forgets what it was about is not history.
  topic        String?
  createdAt    DateTime           @default(now())

  scheduleId String   @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade: a video that was hard-deleted should not take
  /// the record of its own production with it. Soft deletion — the normal case
  /// — leaves this pointing at the row exactly as before.
  videoId String? @db.Uuid
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  /// Belt and braces behind the conditional-update claim. If a bug ever let two
  /// ticks agree that the same occurrence was theirs, the second insert fails
  /// on this constraint before `automationService.start` is ever reached, so
  /// the worst case is a logged error rather than a video billed twice.
  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, createdAt])
  @@map("schedule_run")
}

// ---------------------------------------------------------------------------
// Logging
// ---------------------------------------------------------------------------

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  level      LogLevel @default(INFO)
  action     String
  /// Entity type + id the action targeted, for filtering without a polymorphic FK.
  entityType String?
  entityId   String?  @db.Uuid
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([level, createdAt])
  /// Serves the action dropdown on /logs, which groups this operator's rows
  /// by `action` to list the filter's options with a count each. That is the
  /// one query on the page that must touch every row the operator owns, and
  /// without this index it does so as a sequential scan of the whole table:
  /// at 60k rows it read 1,154 pages in 24.4ms, against 0.14ms for the fifty
  /// rows actually rendered beside it. As an index-only scan it reads 39
  /// pages in 12.8ms — the 30x drop in pages is the point on a box where
  /// `shared_buffers` is 256MB and Postgres shares it with the app and the
  /// render worker.
  ///
  /// Write cost: one extra btree entry per `activityLog.create`, and this
  /// table is append-only and written on nearly every operator action and
  /// pipeline stage. The entry is an append to the right-hand edge for any
  /// single operator, which is the cheap case.
  @@index([userId, action])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

/// The operator's chosen accent, Windows-11 style: one colour that the whole
/// studio adopts for primary buttons, focus rings, links and the active sidebar
/// item.
///
/// A curated set rather than a free hex/oklch column, deliberately. An accent
/// lands on `--primary` (which carries `--primary-foreground` text) and on
/// `--ring` (which has to be visible against the page), so every value has to
/// clear WCAG 4.5:1 in *both* light and dark — and a single stored colour cannot
/// do that, because the lightness that passes on white fails on near-black and
/// vice versa. Each member below therefore expands to a *pair* of derived
/// colours, one per theme, whose ratios are computed and asserted in
/// src/lib/accent.test.ts. A free-colour column would have to do that derivation
/// and rejection at input time on every save, forever, for a range of choice no
/// operator has asked for; Windows itself ships a fixed swatch grid for the same
/// reason.
///
/// GRAPHITE is the absence of an accent, not a colour: it is exactly the
/// monochrome the studio ships today, so it is the column default and every
/// existing row keeps the appearance it has now.
enum AccentColour {
  GRAPHITE
  BLUE
  INDIGO
  VIOLET
  PLUM
  ROSE
  ORANGE
  AMBER
  LIME
  EMERALD
  TEAL
}

model UserSetting {
  id                    String            @id @default(uuid()) @db.Uuid
  theme                 ThemePreference   @default(SYSTEM)
  accent                AccentColour      @default(GRAPHITE)
  defaultScriptProvider AiProviderType    @default(OPENAI)
  defaultVoiceProvider  AiProviderType    @default(ELEVENLABS)
  defaultVoiceId        String?
  defaultVisibility     PublishVisibility @default(PRIVATE)
  defaultTags           String[]
  storageBucket         String?
  defaultScriptPromptId String?           @db.Uuid
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_setting")
}
