// ---------------------------------------------------------------------------
// AI providers
// ---------------------------------------------------------------------------

enum AiProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  ELEVENLABS
  GOOGLE_VEO
  RUNWAY
  KLING
  REPLICATE
  PIKA
  LUMA
  /// Stock footage. Platform-level keys (see env.ts), never a per-operator
  /// ProviderCredential row — used only to tag Asset.provider.
  PEXELS
  PIXABAY
  /// Background music, same platform-level arrangement as the two above.
  JAMENDO
}

model ProviderCredential {
  id           String         @id @default(uuid()) @db.Uuid
  provider     AiProviderType
  label        String?
  /// AES-256-GCM ciphertext. Never selected into any client-bound payload.
  encryptedKey String
  keyLastFour  String
  isActive     Boolean        @default(true)
  lastTestedAt DateTime?
  lastTestOk   Boolean?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  usages ProviderUsage[]

  @@unique([userId, provider])
  @@index([userId, deletedAt])
  @@map("provider_credential")
}

model ProviderUsage {
  id           String         @id @default(uuid()) @db.Uuid
  provider     AiProviderType
  operation    String
  model        String?
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  requestCount Int            @default(1)
  costUsd      Decimal        @default(0) @db.Decimal(12, 6)
  succeeded    Boolean        @default(true)
  latencyMs    Int?
  createdAt    DateTime       @default(now())

  credentialId String?             @db.Uuid
  credential   ProviderCredential? @relation(fields: [credentialId], references: [id], onDelete: SetNull)

  @@index([provider, createdAt])
  @@index([credentialId, createdAt])
  @@map("provider_usage")
}

// ---------------------------------------------------------------------------
// Series — a recurring show
// ---------------------------------------------------------------------------

/// A named, reusable production recipe: one recurring show.
///
/// Everything a show needs already existed before this table did, spread over
/// five screens — the channel's brand, the script style chosen per video in the
/// script panel, the format chosen per video in the approve dialog, and a
/// `Schedule`'s cadence and topic queue. Nothing tied them together or gave
/// them a name, so setting up a second show meant remembering five places and
/// two shows on one channel was not expressible at all.
///
/// ## Almost entirely references
///
/// This table owns exactly two values of its own — `name` and `format` — and
/// four foreign keys. That is deliberate: every other setting a series needs is
/// already stored somewhere that resolves it correctly, and a copy here would
/// be a second value the renderer does not read. In particular there is no
/// `artStyle`, `voiceId`, `musicQuery`, `niche`, `tone` or `footageStyle`
/// column, even though those are the settings an operator most often wants to
/// vary. See `channelId` below for why.
///
/// ## What it does not own
///
/// The cadence and the topic queue live on `Schedule`, which already implements
/// the atomic claim, the no-double-fire lock, the no-burst-after-downtime
/// advance, the DST-correct recurrence and the pause-after-three-failures rule.
/// A series points at one and adds nothing to it — see `Schedule.seriesId`.
model Series {
  id String @id @default(uuid()) @db.Uuid

  /// What the operator calls this show. The whole point of the table: a series
  /// is a *named* thing, and the name is what makes "which of my two shows is
  /// this?" answerable in a list.
  name String

  /// Landscape or vertical, chosen once here instead of on every approve
  /// dialog. Applied by `AutomationService.start`, which passes it to
  /// `VideoService.approveScript` — the one place that has ever written
  /// `Video.format`, unchanged.
  ///
  /// This is the setting that most needs to be per-series rather than per
  /// channel: a channel can perfectly well run a weekly long-form explainer and
  /// a daily vertical, and before this column that meant remembering to pick
  /// the shape by hand on every single video.
  format VideoFormat @default(LANDSCAPE)

  /// Whether an episode of this show uploads itself once it has rendered.
  ///
  /// Off by default, and that default is the important half: a show that
  /// publishes itself spends the operator's channel reputation without asking,
  /// and the failure mode of the other default is not a wasted render but a
  /// video on a real channel that nobody chose to put there.
  ///
  /// Read by `resolveAutoPublish` in schedule.service.ts, which prefers this
  /// over the owned `Schedule`'s copy — the same precedence `promptTemplateId`
  /// and `format` above already follow.
  autoPublish       Boolean           @default(false)
  /// What an auto-published episode goes up as. PRIVATE for the same reason as
  /// the switch above — the safe end of the range is the one you can walk back
  /// from, since this app has no unpublish path.
  publishVisibility PublishVisibility @default(PRIVATE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The channel this show is *of*, and therefore the brand every one of its
  /// videos inherits: niche, tone, voice, music, footage style, art style,
  /// character sheet, language, category and the made-for-kids declaration.
  ///
  /// A series deliberately cannot override any of that. Two reasons, and the
  /// second is the decisive one:
  ///
  ///   1. `ChannelBrand`'s own columns argue it. "A channel that alternates
  ///      between cartoon and live-action footage does not have an identity";
  ///      `madeForKids` is a COPPA declaration made once per channel because
  ///      YouTube itself asks it per channel. Those comments were written about
  ///      videos, and they are just as true of shows.
  ///   2. Nothing would read an override. Every consumer resolves the brand
  ///      through `brandService.resolve(channelId)` reached from
  ///      `video -> project -> channel`, inside the render, footage, publish
  ///      and shorts services. A `Series.artStyle` column would be a value the
  ///      screen displays and the renderer ignores — strictly worse than not
  ///      having it, because the operator would believe it won.
  ///
  /// So two series on one channel share its look and voice, and differ in
  /// script style, format, cadence and topic queue. An operator who genuinely
  /// needs a different look wants a different channel, which is what YouTube
  /// treats as a different identity too and what this app has always supported.
  ///
  /// Stored rather than derived through `projectId` so "every series on this
  /// channel" is one indexed read, and validated on every write to agree with
  /// the project's own channel — see `SeriesService.assertRecipe`.
  channelId String  @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  /// Where this show's videos are filed. `Video.projectId` and
  /// `Schedule.projectId` are both required and neither is this feature's to
  /// change, so a series names a project as well as a channel; the two are kept
  /// consistent by validation rather than by hope.
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Which script style writes every episode.
  ///
  /// A `PromptTemplate`, because that is what a script style already is: the
  /// catalogue in src/lib/script-styles.ts is copied into the operator's own
  /// library by `addScriptStyle`, and `scriptService.generate` has always taken
  /// a `templateId`. Before this column the only caller that passed one was the
  /// per-video picker in the script panel, so a show's style had to be
  /// re-chosen on every video.
  ///
  /// `Restrict` rather than `Cascade` or `SetNull`: templates are soft-deleted,
  /// so this action never actually fires, and `PromptTemplateService.remove`
  /// refuses a template a series is using rather than leaving the series
  /// pointing at a row that no longer resolves.
  promptTemplateId String         @db.Uuid
  promptTemplate   PromptTemplate @relation(fields: [promptTemplateId], references: [id], onDelete: Restrict)

  schedule Schedule?
  videos   Video[]

  @@index([userId, deletedAt])
  /// "Every series on this channel", which is the query behind both the channel
  /// page's series list and the two-shows-on-one-channel case this table exists
  /// for.
  @@index([userId, channelId, deletedAt])
  @@map("series")
}

// ---------------------------------------------------------------------------
// Scheduled automation
// ---------------------------------------------------------------------------

/// How often a schedule fires.
///
/// Two members, and deliberately not a cron expression. This product has
/// exactly one flow — topic in, video out — and every run costs real provider
/// money, so the useful range is "a video a week" to "a video a month". A cron
/// field would additionally admit `* * * * *`, which is a way to spend an
/// operator's entire Anthropic balance in an afternoon by mistyping one
/// character, and would have to be validated back down to roughly this set
/// anyway. Nothing here forecloses adding DAILY later; the arithmetic in
/// src/lib/schedule-time.ts is written per-frequency precisely so a third
/// member is a new branch rather than a rewrite.
enum ScheduleFrequency {
  WEEKLY
  MONTHLY
}

/// PAUSED is the only state in which the due-check ignores a schedule, and it
/// is reached three ways: the operator presses Pause, the topic queue runs dry,
/// or the run has failed `MAX_CONSECUTIVE_FAILURES` times in a row. All three
/// write `pausedReason`, because a schedule that stopped on its own has to be
/// able to say why — an operator who finds no video on Monday needs the answer
/// on the schedule itself, not in a log they would have to know to look for.
///
/// Shared with `ReleaseCadence`, which pauses for its own three reasons and
/// writes `pausedReason` for the same one: an operator who finds no short on
/// Tuesday needs the answer on the row, not in a log.
enum ScheduleStatus {
  ACTIVE
  PAUSED
}

/// Where one auto-publish job is in its life.
///
/// `CLAIMED` is a lease rather than a state the operator cares about — it
/// exists so a second worker does not start an upload whose first attempt is
/// still in flight, and a claim whose lease has lapsed goes back to `WAITING`
/// without counting as a failure. A dead worker is not a failed publish.
enum AutoPublishStatus {
  WAITING
  CLAIMED
  DONE
  FAILED
}

/// Which way /automation draws itself for this operator.
///
/// A column rather than `localStorage`, for the third reason
/// `UserSetting.onboardingSeen` gives for the same choice: the dashboard layout
/// already reads this row for theme and accent, so the chosen view renders on
/// the server and there is no flash of the wrong one on every navigation.
enum AutomationView {
  CANVAS
  TABLE
}

/// What happened at one occurrence.
///
/// SKIPPED and MISSED are different things and the distinction is the point.
/// SKIPPED means the occurrence came round, the worker looked, and there was a
/// reason not to spend money — no ElevenLabs key, no topics left, the project
/// archived. MISSED means nothing looked at all: the occurrence passed while
/// the worker was down, and `advancePast` recorded it on the way past rather
/// than running it late (see src/lib/schedule-time.ts for why a missed
/// occurrence is never made up).
enum ScheduleRunOutcome {
  SUCCEEDED
  SKIPPED
  FAILED
  MISSED
}

/// A recurring instruction to produce a video: which project, how often, and
/// with which answers to the operator's own prompt variables.
///
/// The timing columns store *local wall-clock fields plus an IANA zone*, never
/// a UTC time of day. "Every Monday at 09:00" has to keep meaning 09:00 in the
/// operator's zone across a DST transition, and a stored UTC hour cannot: it
/// would drift by an hour twice a year, silently, in the direction nobody
/// checks. `nextRunAt` is the only UTC instant here, it is derived from those
/// fields, and it is re-derived (never incremented) every time the schedule
/// fires — see `ScheduleService.claimDue`.
model Schedule {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  status       ScheduleStatus @default(ACTIVE)
  /// Written whenever `status` becomes PAUSED, cleared on resume. Null for an
  /// ACTIVE schedule and for one the operator paused by hand without comment.
  pausedReason String?

  frequency  ScheduleFrequency
  /// 0 = Sunday … 6 = Saturday. Set for WEEKLY, null for MONTHLY.
  dayOfWeek  Int?
  /// 1–31. Set for MONTHLY, null for WEEKLY. A day the month does not have
  /// clamps to that month's last day rather than skipping the month.
  dayOfMonth Int?
  hour       Int
  minute     Int
  /// IANA zone name, e.g. `Europe/London`. Validated on the way in — a typo
  /// here would otherwise throw inside the worker's poll loop weeks later.
  timeZone   String

  /// Answers for the variables the operator's default SCRIPT prompt declares,
  /// keyed by `PromptVariable.key` — the same map the guided flow submits. Json
  /// rather than a child table for the same reason `AutomationService` takes a
  /// plain record: which keys exist is a property of a template the operator
  /// can edit at any moment, so a schema that enumerated them would need a
  /// migration every time somebody renamed a variable.
  variables Json @default("{}")

  /// As `Series.autoPublish`, and read only for a **standalone** schedule.
  ///
  /// A series-owned schedule ignores both of these and reads the show's — the
  /// same precedence `promptTemplateId` and `format` already follow through
  /// `ScheduleClaim.series`. A series is the thing the operator configures, and
  /// two places to set one fact is one place to set it wrongly. So for a row
  /// with a `seriesId`, these two columns are deliberately dead: nothing reads
  /// them and no form writes them. See `resolveAutoPublish` in
  /// schedule.service.ts, which is the only place the rule lives.
  autoPublish       Boolean           @default(false)
  publishVisibility PublishVisibility @default(PRIVATE)

  /// The next instant this schedule is due, derived from the fields above. Null
  /// only while paused with no future occurrence computed. This column is the
  /// lock: a claim advances it in the same conditional update that wins it, so
  /// two concurrent ticks can never both fire the same occurrence.
  nextRunAt DateTime?
  /// When the last claim was taken — not when a video was produced. A run that
  /// skipped still moved this, because it is what proves the tick loop looked.
  lastRunAt DateTime?

  /// Held for the duration of one run, so a second worker does not start the
  /// same occurrence while the first is still inside `automationService.start`.
  /// A lease rather than a lock, exactly like `Video.leaseExpiresAt`: a worker
  /// that dies mid-run must not strand the schedule forever.
  claimExpiresAt DateTime?

  /// Reset to zero by any successful run. A schedule that fails this many times
  /// in a row pauses itself rather than billing an Anthropic call every week
  /// for a fault nobody is watching.
  consecutiveFailures Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cascade, not SetNull: a schedule with no project has nowhere to put a
  /// video and no honest state to sit in. Deleting the project is the operator
  /// saying they are done with this line of work.
  projectId String  @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// The series whose cadence this is, or null for a standalone schedule.
  ///
  /// This direction rather than a `scheduleId` on `Series` because it is the
  /// one that leaves every existing row alone: a schedule created before series
  /// existed simply has null here and runs exactly as it always did, and the
  /// due-check does not read this column at all — `claimDue` still selects
  /// active schedules whose `nextRunAt` has arrived, and the claim, the
  /// advance, the lease and the failure counter are untouched. All the series
  /// adds is *how* the run is configured, read in `runTopic` and handed to
  /// `automationService.start`.
  ///
  /// Unique because a show has one cadence. Deleting a series takes its
  /// schedule with it (`Cascade`), which is right: the cadence has no meaning
  /// without the recipe it belongs to, and `ScheduleService.remove` refuses to
  /// delete a series-owned schedule on its own for the same reason.
  seriesId String? @unique @db.Uuid
  series   Series? @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  topics ScheduleTopic[]
  runs   ScheduleRun[]

  /// The due-check's candidate scan: active schedules whose next occurrence has
  /// arrived, oldest first. Mirrors `Video`'s own `[status, leaseExpiresAt]`.
  @@index([status, nextRunAt])
  @@index([userId, deletedAt])
  @@map("schedule")
}

/// One subject the operator wrote ahead of time, waiting its turn.
///
/// The queue is where topics come from, rather than a model inventing one each
/// week. A standing instruction ("pick something about personal finance") would
/// mean the studio choosing the subject of a video the operator pays for and
/// puts their name on, and getting that wrong is not a small failure — it is a
/// video about something they would never have covered, discovered after it was
/// rendered. A queue is cheap, predictable, reviewable in advance, and when it
/// empties the schedule stops rather than improvising.
model ScheduleTopic {
  id         String    @id @default(uuid()) @db.Uuid
  /// Sort key, not an index into anything. Consumed rows keep their position so
  /// history reads in the order the operator wrote them.
  position   Int
  topic      String
  /// Set when a run takes this topic, which happens *before* the model is
  /// called — see `ScheduleService.executeClaim` for why a failed run does not
  /// put the topic back.
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  scheduleId String   @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// "The next unconsumed topic for this schedule" is a prefix scan of this
  /// b-tree, which is the single hottest query in the tick path.
  @@index([scheduleId, consumedAt, position])
  @@map("schedule_topic")
}

/// Append-only history: one row per occurrence, whatever became of it.
///
/// Every occurrence writes a row, including the ones that produced nothing.
/// "No video appeared on Monday" is the question this table exists to answer,
/// and it can only answer it if a skip is as visible as a success.
model ScheduleRun {
  id           String             @id @default(uuid()) @db.Uuid
  /// The occurrence this row is about, not when the row was written. Those
  /// differ for a run the worker picked up late, and the occurrence is the one
  /// the operator can reason about.
  scheduledFor DateTime
  outcome      ScheduleRunOutcome
  /// Why, in the operator's terms. Always set for SKIPPED, FAILED and MISSED;
  /// null for a plain success.
  reason       String?
  /// The topic this run consumed, copied rather than referenced: the
  /// `ScheduleTopic` row can be removed by the operator, and history that
  /// forgets what it was about is not history.
  topic        String?
  createdAt    DateTime           @default(now())

  scheduleId String   @db.Uuid
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade: a video that was hard-deleted should not take
  /// the record of its own production with it. Soft deletion — the normal case
  /// — leaves this pointing at the row exactly as before.
  videoId String? @db.Uuid
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: SetNull)

  /// Belt and braces behind the conditional-update claim. If a bug ever let two
  /// ticks agree that the same occurrence was theirs, the second insert fails
  /// on this constraint before `automationService.start` is ever reached, so
  /// the worst case is a logged error rather than a video billed twice.
  @@unique([scheduleId, scheduledFor])
  @@index([scheduleId, createdAt])
  @@map("schedule_run")
}

/// One row per video made by an automation that was set to publish itself.
///
/// A table rather than four more columns on `Video`, for three reasons. It
/// keeps scheduler bookkeeping — attempts, backoff, lease — out of a model that
/// is about a video rather than about a queue. It mirrors `RenderJob`, which is
/// the same shape for the same reason one stage earlier. And it gives a caller
/// a countable "waiting to publish" without scanning videos.
model AutoPublishJob {
  id String @id @default(uuid()) @db.Uuid

  /// `@unique`, and that is the backstop rather than the mechanism —
  /// `AutoPublishService.claimDue`'s conditional update is what prevents a
  /// double upload. This makes a second enqueue of the same video impossible
  /// even if a caller is written wrongly later.
  videoId String @unique @db.Uuid
  video   Video  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Frozen at enqueue, which is the whole reason this row is written when the
  /// video is created rather than when it is ready. An operator may turn a
  /// series' auto-publish off, or move it from PUBLIC to PRIVATE, while three
  /// of its episodes are mid-render. Those three go out as what they were made
  /// under. Reading the series at publish time instead would let a setting
  /// changed on Tuesday silently rewrite what Monday's video does — a decision
  /// the operator never made, about a video they had stopped thinking about.
  visibility PublishVisibility

  status   AutoPublishStatus @default(WAITING)
  attempts Int               @default(0)

  /// Not before this. Moved forward by backoff after an ordinary failure, and
  /// to the next quota reset after a spent allowance.
  runAfter DateTime @default(now())

  /// Set while a worker holds this job, sized like `ReleaseCadence.claimExpiresAt`
  /// because the work is the same work: one file off disk and one
  /// `videos.insert`.
  leaseExpiresAt DateTime?

  /// Why the last attempt failed, in a sentence safe to show verbatim.
  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The claim query's index: due jobs, oldest first.
  @@index([status, runAfter])
  @@map("auto_publish_job")
}

/// Where one node sits on this operator's automation canvas.
///
/// Positions carry no information — the structure *is* the data, in the foreign
/// keys between channel, project, series and schedule — so this table buys
/// arrangement rather than meaning. That is a real thing to want, and wanting it
/// is the only reason this exists.
///
/// It is also why nothing here is load bearing. A row that goes missing costs a
/// node its remembered place and `autoPlace` puts it somewhere sensible; no
/// read anywhere fails because a position is absent.
model CanvasNode {
  id String @id @default(uuid()) @db.Uuid

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// "channel:<id>", "series:<id>", "schedule:<id>", "release:<id>",
  /// "publish:series:<id>".
  ///
  /// A string rather than a foreign key, and the same choice
  /// `AutomationEntry.rowId` and `UserSetting.onboardingSeen` already make: ids
  /// are unique only within one table, five kinds of thing share this canvas,
  /// and a sixth should be a content change rather than a migration.
  ///
  /// The cost is that a deleted series leaves a row pointing at nothing. That is
  /// harmless — `CanvasService.read` looks positions *up* by the keys it is
  /// already drawing and never lists this table — so they are swept lazily
  /// rather than by a cascade this key cannot express.
  nodeKey String

  x Float
  y Float

  updatedAt DateTime @updatedAt

  @@unique([userId, nodeKey])
  @@map("canvas_node")
}

// ---------------------------------------------------------------------------
// Shorts release
// ---------------------------------------------------------------------------

/// A channel's standing instruction to release banked shorts at fixed times of
/// day.
///
/// ## Why this is not a `Schedule`
///
/// The obvious move was a third `ScheduleFrequency` — `DAILY` — and it is the
/// wrong one. A `Schedule` *produces*: every occurrence is a model call, a
/// narration, a render and a bill. Three shorts a day on three channels would
/// be twenty-one fresh videos a week per channel, for content the operator has
/// already paid to make: the week's three long videos each yield around seven
/// clips, and 3 × 7 is exactly the 21 a week that three-a-day needs. So the
/// shorts half of the operator's week is not a production cadence at all — it
/// is a *release* cadence, and releasing a banked clip is an ffmpeg output that
/// already exists plus one upload. Nothing here calls a model, and nothing here
/// can spend provider money.
///
/// That difference changes the failure the design has to defend against.
/// `Schedule` protects a budget, which is why an empty topic queue pauses it:
/// a schedule with nothing to make must stop rather than improvise. A cadence
/// with nothing banked has not failed and must not pause — the operator simply
/// has not published a long video this week, and the drip resumes by itself the
/// moment one lands. See `ReleaseRun`'s SKIPPED outcome.
///
/// ## What it borrows unchanged
///
/// Everything about the timing. `slotMinutes` + `timeZone` are wall-clock
/// fields plus a zone, never UTC times of day, for exactly the reason
/// `Schedule`'s own comment gives — a stored UTC hour drifts by an hour twice a
/// year in the direction nobody checks. `nextReleaseAt` is the only UTC instant
/// here, it is derived from those fields, and it is re-derived (never
/// incremented) in the same conditional update that claims it. See
/// `ReleaseService.claimDue` and src/lib/release-time.ts.
model ReleaseCadence {
  id String @id @default(uuid()) @db.Uuid

  /// Shared with `Schedule` rather than duplicated: ACTIVE/PAUSED means the
  /// same thing here, and `claimDue` ignores a PAUSED row the same way.
  status       ScheduleStatus @default(ACTIVE)
  /// Written whenever `status` becomes PAUSED, cleared on resume. Reached by
  /// the operator's own Pause, by repeated upload failures, and by a channel
  /// that has gone — never by an empty queue, which is the one difference from
  /// `Schedule.pausedReason` worth knowing.
  pausedReason String?

  /// Times of day, as minutes past local midnight, ascending and distinct —
  /// `[480, 840, 1200]` is 08:00, 14:00 and 20:00.
  ///
  /// A scalar list rather than a child table because a slot has no state of
  /// its own: which occurrence is next is a property of the whole set (see
  /// `nextSlotAfter`), not of one row, and there is nothing per-slot to claim,
  /// lease or count. Minutes rather than a pair of `hour`/`minute` columns
  /// because the set is variable-length — three is the operator's case, not a
  /// constraint — and one comparable integer is what makes "sort the day's
  /// candidates by instant" (which DST forces, see `nextSlotAfter`) a sort
  /// rather than a tuple comparison.
  slotMinutes Int[]

  /// IANA zone name, e.g. `Europe/London`. Validated on the way in, same as
  /// `Schedule.timeZone` and for the same reason.
  timeZone String

  /// What a dripped short goes out as. PUBLIC by default, which is the one
  /// default in the publishing path that is not PRIVATE, and deliberately: a
  /// release cadence that published privately would be a standing instruction
  /// to do nothing anybody can see. The safety rule publishing is built on —
  /// nothing reaches YouTube the operator did not ask for — is satisfied by
  /// the cadence itself being the ask.
  visibility PublishVisibility @default(PUBLIC)

  /// The next instant a slot is due. This column is the lock: a claim advances
  /// it in the same conditional update that wins it, so two concurrent ticks
  /// can never both release into the same slot. Null only while paused.
  nextReleaseAt DateTime?
  /// When the last slot was claimed — not when a short went out. A slot that
  /// found nothing banked still moves this, because it is what proves the tick
  /// looked.
  lastReleaseAt DateTime?

  /// Held for one release. An upload is tens of megabytes over a network that
  /// can hang, so this is a lease and not a lock: a worker that dies mid-upload
  /// must not strand the cadence until somebody notices.
  claimExpiresAt DateTime?

  /// Reset to zero by any successful release. A cadence that fails this many
  /// times in a row pauses itself and says why — the case this exists for is a
  /// spent YouTube quota, which is per Google Cloud project rather than per
  /// channel and so fails identically on every slot until the operator is told.
  /// An empty queue never touches this counter.
  consecutiveFailures Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One cadence per channel, which is the operator's own model: a channel
  /// posts three times a day at its own times, in its own zone, with its own
  /// branding. Unique rather than a list because two cadences on one channel
  /// would race for the same queue with no rule for who wins.
  ///
  /// No `deletedAt`, unlike most user-owned rows here. Soft deletion and this
  /// `@unique` are incompatible: a soft-deleted cadence still occupies the
  /// channel's slot, so the operator could never set a new one up. Pausing is
  /// the off switch; deleting is explicit and takes the history with it.
  channelId String  @unique @db.Uuid
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  runs ReleaseRun[]

  /// The due-check's candidate scan: active cadences whose next slot has
  /// arrived, oldest first. Mirrors `Schedule`'s own `[status, nextRunAt]`.
  @@index([status, nextReleaseAt])
  @@index([userId])
  @@map("release_cadence")
}

/// Append-only history: one row per slot, whatever became of it.
///
/// The question this table exists to answer is "why did nothing go out on
/// Tuesday?", and it can only answer it if a slot that released nothing is as
/// visible as one that released something. The four outcomes are
/// `ScheduleRunOutcome`'s, shared rather than duplicated because they mean the
/// same four things:
///
///   * SUCCEEDED — a clip went up. `shortId` and `youtubeVideoId` say which.
///   * SKIPPED — the slot came round, the worker looked, and there was a reason
///     not to upload. Overwhelmingly "nothing is banked", which is a normal
///     state and not a fault: it means the week's long videos have not produced
///     clips yet.
///   * FAILED — the upload was attempted and refused. A spent quota lands here.
///   * MISSED — nothing looked at all: the slot passed while the worker was
///     down, and `advancePastSlots` recorded it on the way past rather than
///     releasing it late. A short published four hours after its slot is worse
///     than one not published: the slot was chosen because of when the
///     channel's audience is awake.
model ReleaseRun {
  id String @id @default(uuid()) @db.Uuid

  /// The slot this row is about, not when the row was written. Those differ
  /// for a release the worker picked up late, and the slot is the one the
  /// operator can reason about.
  scheduledFor DateTime
  outcome      ScheduleRunOutcome
  /// Why, in the operator's terms. Always set for SKIPPED, FAILED and MISSED;
  /// null for a plain success.
  reason       String?

  /// What was uploaded, copied rather than only referenced. Regenerating a
  /// video's shorts hard-deletes the previous set (see `Short`), and history
  /// that forgets what it released is not history.
  shortTitle     String?
  youtubeVideoId String?

  createdAt DateTime @default(now())

  cadenceId String         @db.Uuid
  cadence   ReleaseCadence @relation(fields: [cadenceId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade, exactly as `ScheduleRun.videoId` is: a short
  /// that is hard-deleted by a regeneration should not take the record of its
  /// own release with it.
  shortId String? @db.Uuid
  short   Short?  @relation(fields: [shortId], references: [id], onDelete: SetNull)

  /// Belt and braces behind the conditional-update claim. If a bug ever let two
  /// ticks agree that the same slot was theirs, the second insert fails on this
  /// constraint before a single byte is uploaded, so the worst case is a logged
  /// error rather than the same clip on YouTube twice.
  @@unique([cadenceId, scheduledFor])
  @@index([cadenceId, createdAt])
  @@map("release_run")
}

// ---------------------------------------------------------------------------
// Logging
// ---------------------------------------------------------------------------

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  level      LogLevel @default(INFO)
  action     String
  /// Entity type + id the action targeted, for filtering without a polymorphic FK.
  entityType String?
  entityId   String?  @db.Uuid
  message    String?
  metadata   Json?
  createdAt  DateTime @default(now())

  userId String? @db.Uuid
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([level, createdAt])
  /// Serves the action dropdown on /logs, which groups this operator's rows
  /// by `action` to list the filter's options with a count each. That is the
  /// one query on the page that must touch every row the operator owns, and
  /// without this index it does so as a sequential scan of the whole table:
  /// at 60k rows it read 1,154 pages in 24.4ms, against 0.14ms for the fifty
  /// rows actually rendered beside it. As an index-only scan it reads 39
  /// pages in 12.8ms — the 30x drop in pages is the point on a box where
  /// `shared_buffers` is 256MB and Postgres shares it with the app and the
  /// render worker.
  ///
  /// Write cost: one extra btree entry per `activityLog.create`, and this
  /// table is append-only and written on nearly every operator action and
  /// pipeline stage. The entry is an append to the right-hand edge for any
  /// single operator, which is the cheap case.
  @@index([userId, action])
  @@map("activity_log")
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

/// The operator's chosen accent, Windows-11 style: one colour that the whole
/// studio adopts for primary buttons, focus rings, links and the active sidebar
/// item.
///
/// A curated set rather than a free hex/oklch column, deliberately. An accent
/// lands on `--primary` (which carries `--primary-foreground` text) and on
/// `--ring` (which has to be visible against the page), so every value has to
/// clear WCAG 4.5:1 in *both* light and dark — and a single stored colour cannot
/// do that, because the lightness that passes on white fails on near-black and
/// vice versa. Each member below therefore expands to a *pair* of derived
/// colours, one per theme, whose ratios are computed and asserted in
/// src/lib/accent.test.ts. A free-colour column would have to do that derivation
/// and rejection at input time on every save, forever, for a range of choice no
/// operator has asked for; Windows itself ships a fixed swatch grid for the same
/// reason.
///
/// GRAPHITE is the absence of an accent, not a colour: it is exactly the
/// monochrome the studio ships today, so it is the column default and every
/// existing row keeps the appearance it has now.
enum AccentColour {
  GRAPHITE
  BLUE
  INDIGO
  VIOLET
  PLUM
  ROSE
  ORANGE
  AMBER
  LIME
  EMERALD
  TEAL
}

model UserSetting {
  id                    String            @id @default(uuid()) @db.Uuid
  theme                 ThemePreference   @default(SYSTEM)
  accent                AccentColour      @default(GRAPHITE)
  defaultScriptProvider AiProviderType    @default(OPENAI)
  defaultVoiceProvider  AiProviderType    @default(ELEVENLABS)
  defaultVoiceId        String?
  defaultVisibility     PublishVisibility @default(PRIVATE)
  defaultTags           String[]
  storageBucket         String?
  defaultScriptPromptId String?           @db.Uuid
  /// Which pieces of onboarding this person has already read and put away:
  /// the first-run tour, the setup checklist, and one entry per screen hint
  /// (`help:automation`, `help:channels`, …). See
  /// src/features/onboarding/dismissal.ts for the key vocabulary.
  ///
  /// A column rather than `localStorage`, which is where the single
  /// tour-seen flag used to live and where the video page's section state
  /// still does. Three things changed the answer:
  ///
  ///   1. It is no longer one flag. Twenty-odd hints times however many
  ///      browsers an operator uses is twenty-odd re-teachings per device,
  ///      and being re-taught what you already know is the same complaint —
  ///      "it's so difficult" — pointed the other way.
  ///   2. Replay has to be findable. "Show the guides again" on /settings can
  ///      only clear what the server can see; a `localStorage` set is
  ///      invisible to the phone the operator is holding.
  ///   3. It removes a flash. The layout already reads this row for theme and
  ///      accent, so a hint that will not be shown is never rendered at all,
  ///      rather than rendered and then withdrawn by a client effect.
  ///
  /// A `String[]` rather than a column per hint so that adding a screen hint
  /// is a content change, never a migration.
  onboardingSeen        String[]          @default([])
  /// Canvas or table on /automation.
  ///
  /// CANVAS by default because the complaint that produced the canvas was that
  /// the table reads like a CRM — it answers "which automation is unhealthy"
  /// and not "what is my kids channel doing". An operator who prefers the table
  /// flips it once and it sticks, which is why this is a column and not a
  /// constant.
  automationView        AutomationView    @default(CANVAS)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_setting")
}
