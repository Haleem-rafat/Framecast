# Patterns are intentionally unanchored so they match at any depth.

# dependencies
node_modules
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
out/

# production
build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real secrets.
#
# Two families, because two naming conventions exist in this repo:
#   .env, .env.local, .env.production  — the app's own, dot-prefixed.
#   deploy/prod.env, deploy/staging.env, deploy/backup.env — the server's,
#     created by docs/vps-deployment.md by copying a .example next to them
#     and filling it in. These do NOT start with ".env", so `.env*` alone
#     never matched them, and they hold CREDENTIAL_ENCRYPTION_KEY,
#     BETTER_AUTH_SECRET, POSTGRES_PASSWORD and the R2 keys.
# Patterns are unanchored, so both families are covered at any depth.
# The negations must stay AFTER their patterns: a later re-ignore would
# silently undo them (which is exactly what a stray `.env*` further down
# this file used to do to `!.env.example`).
.env
.env.*
*.env
!.env.example
!*.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
src/generated/prisma

# finished renders live on local disk — see src/lib/render-storage.ts. Large
# binaries, machine-local, never committed.
.framecast/

# Agent worktrees — real git worktrees of this repo, never content of it.
# Committed accidentally by `git add -A`, they land as gitlinks (mode 160000)
# with no .gitmodules: a clone gets nine empty directories and git errors.
.claude/worktrees/
